---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectRow from '../components/ProjectRow.astro';
import projects from '../data/projects.json';
import { profile, stats, ticker, experience, skills, education, certifications, testimonials } from '../data/site.js';

const featured = projects.filter((p) => p.featured);
const termLines = [
  { k: 'cmd', t: 'stack --layers' },
  { k: 'out', t: 'frontend   react, next.js, tailwind' },
  { k: 'out', t: 'backend    laravel, php, python' },
  { k: 'out', t: 'data       mysql, postgresql' },
  { k: 'out', t: 'integrate  rest, oauth 2.0' },
  { k: 'cmd', t: 'projects --count' },
  { k: 'out', t: '19 to open, 2 in production' },
];
const skillIcons = { Backend: 'server', Frontend: 'layout', Data: 'database', Integration: 'plug', Delivery: 'rocket', Practice: 'compass' };
const layers = [
  { icon: 'layout', name: 'Frontend', text: 'React, Next.js, JavaScript, TypeScript, Tailwind CSS' },
  { icon: 'server', name: 'Backend', text: 'Laravel, PHP, CodeIgniter, Node.js, Python' },
  { icon: 'database', name: 'Data', text: 'MySQL, PostgreSQL, Drizzle ORM' },
  { icon: 'plug', name: 'Integration', text: 'REST API, OAuth 2.0, Accurate Online, WhatsApp links' },
];
const social = [
  { icon: 'github', label: 'GitHub', href: profile.github },
  { icon: 'linkedin', label: 'LinkedIn', href: profile.linkedin },
  { icon: 'whatsapp', label: 'WhatsApp', href: profile.whatsapp },
  { icon: 'mail', label: 'Email', href: `mailto:${profile.email}` },
];
import sites from '../data/websites.json';
const briefKinds = ['Company profile website', 'Cashier and POS', 'Booking and reservation', 'HR and payroll', 'Manufacturing and ERP', 'Customer management (CRM)', 'WhatsApp and email blast', 'Something else'];
const briefWhen = ['As soon as possible', 'Within a month', 'In 2 to 3 months', 'Just exploring'];
const beltA = sites;
const beltB = [...sites].reverse();
const proj = (t) => projects.find((p) => p.title === t);
const mrp = proj('MRP Flow');
const hris = proj('CG HRIS');
const erpDemo = proj('ErpCore');
const miniSites = sites.slice(0, 4);
---
<Base current="home">
  <!-- Shown only when the page is printed: the header of a one-page CV. -->
  <section class="print-cv">
    <h1>{profile.name}</h1>
    <p>{profile.role}, {profile.location}</p>
    <p>{profile.email} / {profile.phone} / linkedin.com/in/bagasaria / github.com/bagasaria93</p>
  </section>

  <!-- Hero: dark console -->
  <section class="hero dark" aria-labelledby="hero-title">
    <span class="wordmark" data-css="-webkit-text-stroke mask-image font-stretch" aria-hidden="true">BAGAS ARIA SATIVA</span>
    <div class="container hero-inner">
      <div>
        <p class="hero-id"><b>Portfolio</b><span>2026</span><span>Bekasi, Indonesia</span></p>
        <h1 class="hero-title" id="hero-title" data-css="font-stretch letter-spacing text-wrap">Bagas Aria <em>Sativa</em></h1>
        <p class="hero-role"><b>Full-Stack Developer.</b> Systems, layer by layer.</p>
        <p class="hero-lead">I build web applications end to end: Laravel and PHP back ends, React and Next.js interfaces, Python data tools, and the integrations that connect them to other systems.</p>
        <div class="hero-cta">
          <a class="btn btn--primary" href="#work">View selected work <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost" href={profile.cv} download><Icon name="download" /> Download CV</a>
        </div>
        <div class="hero-meta">
          <div class="social">
            {social.map((s) => (
              <a href={s.href} aria-label={s.label} title={s.label} target={s.href.startsWith('http') || s.href.startsWith('mailto:') ? '_blank' : undefined} rel={s.href.startsWith('http') || s.href.startsWith('mailto:') ? 'noopener' : undefined}><Icon name={s.icon} /></a>
            ))}
          </div>
          <p class="status"><span class="dot" aria-hidden="true"></span>Open to remote and onsite roles</p>
        </div>
        <ul class="hero-stats" role="list">
          {stats.map((s) => (
            <li>
              <strong data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</strong>
              <span>{s.label}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="idscene" data-card role="group" aria-label="Identity card of Bagas Aria Sativa, front and back. Drag to turn it over.">
        <div class="idstage">
          <div class="idcard" data-idcard data-css="transform-style backface-visibility perspective conic-gradient">
            <div class="idclip" aria-hidden="true"></div>
            <div class="idface front" data-face="front">
              <div class="idtop"><b>B.A.S</b><span>Portfolio 2026</span></div>
              <div class="idphoto"><img src="/assets/img/profile.webp" width="399" height="600" alt="Portrait of Bagas Aria Sativa" decoding="async" fetchpriority="high" /></div>
              <p class="idname">Bagas Aria Sativa</p>
              <p class="idrole">Full-Stack Developer / Bekasi</p>
              <div class="idbar" aria-hidden="true"></div>
              <div class="idsheen" aria-hidden="true"></div>
            </div>
            <div class="idface back" data-face="back" inert>
              <div class="idback">
                <p class="k">The stack</p>
                <h2>Systems, layer by layer.</h2>
                <dl>
                  {layers.map((l) => (<div><dt>{l.name}</dt><dd>{l.text.replace(', WhatsApp links', '')}</dd></div>))}
                  <div><dt>Contact</dt><dd><a href={`mailto:${profile.email}`} target="_blank" rel="noopener">{profile.email}</a></dd></div>
                </dl>
              </div>
            </div>
            <div class="idedge l" aria-hidden="true"></div>
            <div class="idedge r" aria-hidden="true"></div>
          </div>
        </div>
        <button class="idflip" type="button" data-flip aria-label="Turn the card over">Turn the card over</button>
      </div>
    </div>
  </section>

  <!-- Ticker -->
  <div class="ticker" aria-label="Core technologies">
    <div class="ticker-track" data-css="animation-name animation-duration animation-timing-function">
      <ul class="ticker-group" role="list">{ticker.map((t) => <li>{t}</li>)}</ul>
      <ul class="ticker-group" role="list" aria-hidden="true">{ticker.map((t) => <li>{t}</li>)}</ul>
    </div>
  </div>

  <!-- At a glance -->
  <section class="glance" aria-label="At a glance" style="padding-top:var(--sp)">
    <div class="container">
      <div class="depth-head reveal">
        <p class="eyebrow"><Icon name="layers" /> Highlights</p>
        <a class="link-arrow" href="#work"><span>All selected work</span><Icon name="arrow-right" size={16} /></a>
      </div>
      <div class="depth" data-tiles>
        <a class="dtile" data-tilt href={mrp.href} target="_blank" rel="noopener" aria-label="MRP Flow: view live demo (opens in a new tab)" data-css="transform-style translate perspective">
          <span class="shd"></span>
          <span class="base"><img src={mrp.image} width="1100" height="688" alt="" loading="lazy" decoding="async" /></span>
          <span class="z lbl">MRP Flow</span><span class="z chip">Live demo</span><span class="glare"></span>
        </a>
        <a class="dtile" data-tilt href="/case-study/erp/" aria-label="ERP case study: twelve departments in one system">
          <span class="shd"></span>
          <span class="base"><img src={erpDemo.image} width="1100" height="688" alt="" loading="lazy" decoding="async" /></span>
          <span class="z num">12<small>departments</small></span><span class="z lbl">ERP case study</span><span class="z chip">Case study</span><span class="glare"></span>
        </a>
        <a class="dtile" data-tilt href={hris.href} aria-label="CG HRIS: view demo">
          <span class="shd"></span>
          <span class="base"><img src={hris.image} width="1100" height="688" alt="" loading="lazy" decoding="async" /></span>
          <span class="z lbl">CG HRIS</span><span class="z chip">Live demo</span><span class="glare"></span>
        </a>
        <a class="dtile" data-tilt href="/websites/" aria-label="Company profile websites: all fifteen demos">
          <span class="shd"></span>
          <span class="base" style="background:var(--paper-3)"></span>
          {miniSites.map((m, i) => (
            <span class="z mini" style={`left:${6 + (i % 2) * 47}%;top:${8 + Math.floor(i / 2) * 29}%;transform:translateZ(${28 + i * 24}px)`}><img src={m.image} width="1100" height="688" alt="" loading="lazy" decoding="async" /></span>
          ))}
          <span class="z lbl">{sites.length} websites</span><span class="z chip">{sites.length} industries</span><span class="glare"></span>
        </a>
      </div>
    </div>
    <div class="container hero-bento">
      <div class="tile tile--stack reveal">
        <p class="tile-label"><span>The stack, layer by layer</span><span>full-stack</span></p>
        <div class="layers">
          {layers.map((l) => (
            <div class="layer"><strong><Icon name={l.icon} /> {l.name}</strong><span>{l.text}</span></div>
          ))}
        </div>
      </div>
      <div class="tile tile--term reveal" style="--i:1">
        <p class="tile-label"><span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span><span>terminal</span></p>
        <div class="term-body" data-terminal data-lines={JSON.stringify(termLines)} aria-label="Summary of the stack and project count">{termLines.map((l) => (
          <div>{l.k === 'cmd' ? <><span class="p">$ </span><span class="k">{l.t}</span></> : <span class="o">{l.t}</span>}</div>
        ))}</div>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="reveal">
        <p class="eyebrow"><Icon name="user" /> About</p>
        <h2 class="section-title" id="about-title">Software that people use <mark>every day</mark></h2>
        <p class="section-lead">Based in Bekasi, I build production-grade software used daily by real teams. My work spans ERP and HRIS platforms, booking systems, POS applications, data tools and mobile apps, across manufacturing and service industries.</p>
        <p class="section-lead">I work end to end: from database design and backend logic in Laravel to the interfaces people click through. Beyond writing code, I analyse business workflows and gather requirements, so that what I ship fits how people actually work.</p>
        <ul class="about-facts" role="list">
          <li><Icon name="map-pin" /> Bekasi, Indonesia</li>
          <li><Icon name="graduation" /> Master of Computer Science, in progress</li>
          <li><Icon name="layers" /> Database to interface, end to end</li>
        </ul>
      </div>
      <div class="portraits reveal" style="--i:2">
        <figure class="portrait portrait--a" data-css="border-top-width box-shadow">
          <div class="ph"><img data-css="filter mix-blend-mode" src="/assets/img/profile.webp" alt="Portrait of Bagas Aria Sativa" width="399" height="600" loading="lazy" decoding="async" /></div>
          <figcaption><span>Bagas</span><span>01</span></figcaption>
        </figure>
        <figure class="portrait portrait--b">
          <div class="ph"><img src="/assets/img/profile2.webp" alt="Bagas Aria Sativa playing golf" width="1080" height="1080" loading="lazy" decoding="async" /></div>
          <figcaption><span>Off duty: golf</span><span>02</span></figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- Selected work -->
  <section class="section" id="work" aria-labelledby="work-title" style="padding-top:0">
    <div class="container">
      <div class="work-head reveal">
        <div class="section-head">
          <p class="eyebrow"><Icon name="folder" /> Selected work</p>
          <h2 class="section-title" id="work-title">Working software, <mark>not mockups</mark></h2>
          <p class="section-lead">Six demos that run in your browser, across Next.js, React, React Native and Python. Each one is designed, built and shipped by me. Point at a row to preview it.</p>
        </div>
        <p class="work-count" data-css="font-stretch letter-spacing" aria-hidden="true">{projects.length}<small>projects you can open</small></p>
      </div>
      <div class="rows reveal" data-rows>
        {featured.map((p, i) => <ProjectRow project={p} index={i} />)}
        <article class="row row--all">
          <a class="row-link" href="/work/" aria-label={`Browse all ${projects.length} projects`}>
            <span class="row-n">+{projects.length - featured.length}</span>
            <span class="row-main">
              <h3 class="row-t">Browse all {projects.length} projects</h3>
              <span class="row-s">Filter by type or search by technology: business systems, web tools, data and AI, mobile and PWA, and websites.</span>
            </span>
            <span></span>
            <span class="row-go" aria-hidden="true"><Icon name="arrow-right" size={22} /></span>
          </a>
        </article>
      </div>
    </div>
    <div class="peek" data-peek-el aria-hidden="true"><div class="peek-in"><img alt="" width="900" height="563" /><p class="peek-cap"></p></div></div>
  </section>

  <!-- Company profile websites: two belts of live demos moving in opposite directions -->
  <section class="section dark sites-home" id="websites" aria-labelledby="sites-title">
    <div class="container">
      <div class="work-head reveal">
        <div class="section-head">
          <p class="eyebrow"><Icon name="globe" /> Websites for business</p>
          <h2 class="section-title" id="sites-title">Fifteen industries, <mark>fifteen live websites</mark></h2>
          <p class="section-lead">Company profile websites for gyms, restaurants, clinics, workshops, schools, factories and more. Every one runs live, so you can click through it before we build yours.</p>
        </div>
        <p class="work-count" aria-hidden="true">{sites.length}<small>industries, one demo each</small></p>
      </div>
    </div>
    <div class="belts" data-css="display gap" aria-label="Website demos by industry">
      {[beltA, beltB].map((list, row) => (
        <div class={`belt ${row ? 'belt--rev' : ''}`} data-css="mask-image overflow">
          <div class="belt-track">
            {[0, 1].map((copy) => (
              <ul class="belt-group" role="list" aria-hidden={copy ? 'true' : undefined}>
                {list.map((s) => (
                  <li>
                    <a class="belt-card" href={s.href} tabindex={copy ? -1 : undefined}>
                      <img src={s.image} width={s.width} height={s.height} alt={copy ? '' : `Preview of ${s.name}, ${s.industry} company profile`} loading="lazy" decoding="async" />
                      <span><b>{s.name}</b><small>{s.industry}</small></span>
                    </a>
                  </li>
                ))}
              </ul>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="container belts-cta">
      <a class="btn btn--primary" href="/websites/">See all {sites.length} websites <Icon name="arrow-right" /></a>
      <a class="btn btn--ghost" href="/?brief=website#contact">Plan my website <Icon name="mail" /></a>
    </div>
  </section>

  <!-- Case studies -->
  <section class="section alt" id="case" aria-labelledby="case-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow"><Icon name="layers" /> Case studies</p>
        <h2 class="section-title" id="case-title">Two production systems, <mark>explained</mark></h2>
        <p class="section-lead">What the problem was, what I decided and why. Company data is never shown.</p>
      </div>
      <div class="case-cards">
        <article class="case-card reveal">
          <span class="big" data-css="-webkit-text-stroke font-stretch color" aria-hidden="true">12</span>
          <small>Manufacturing</small>
          <h3 style="view-transition-name: case-erp">ERP for 12 departments</h3>
          <p>Access control, multi-level approvals, material planning, quality inspection and a fail-safe connection to an accounting system. Includes an interactive approval demo.</p>
          <ul class="tags" role="list"><li class="tag">Laravel</li><li class="tag">MySQL</li><li class="tag">REST API</li><li class="tag">OAuth 2.0</li></ul>
          <a class="link-arrow" href="/case-study/erp/"><span>Read the ERP case study</span><Icon name="arrow-right" size={16} /></a>
        </article>
        <article class="case-card reveal" style="--i:1">
          <span class="big" aria-hidden="true">3</span>
          <small>HR and service</small>
          <h3 style="view-transition-name: case-rainbrow">Aftercare, booking and HRIS</h3>
          <p>Three applications built end to end for a service company: an aftercare platform for ratings and follow-up, a QR booking platform with a customer points program, and an HR information system.</p>
          <ul class="tags" role="list"><li class="tag">CodeIgniter 3</li><li class="tag">MySQL</li><li class="tag">Bootstrap</li><li class="tag">Tailwind CSS</li></ul>
          <a class="link-arrow" href="/case-study/rainbrow/"><span>Read the Rainbrow case study</span><Icon name="arrow-right" size={16} /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Experience -->
  <section class="section" id="experience" aria-labelledby="exp-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow"><Icon name="briefcase" /> Experience</p>
        <h2 class="section-title" id="exp-title">Where I have <mark>built things</mark></h2>
      </div>
      <div class="xp" data-timeline data-xp>
        <nav class="xp-nav" aria-label="Jobs">
          <span class="timeline-fill" data-css="transform-origin transform" aria-hidden="true"></span>
          <ol role="list">
            {experience.map((j, i) => (
              <li><a href={`#job-${i}`} data-xp-link><small>{j.period}</small><b>{j.org}</b></a></li>
            ))}
          </ol>
        </nav>
        <div class="xp-list">
          {experience.map((j, i) => (
            <article class="job reveal" id={`job-${i}`} data-job>
              <div class="job-head">
                <p class="job-period"><Icon name="calendar" /> {j.period}</p>
                <h3>{j.title}</h3>
                <p class="job-org"><Icon name="building" /> {j.org}</p>
                <p class="job-meta"><Icon name="map-pin" /> {j.meta}</p>
                <p class="job-stack">{j.stack}</p>
              </div>
              <ul role="list">{j.points.map((p) => <li>{p}</li>)}</ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Skills -->
  <section class="section" id="skills" aria-labelledby="skills-title" style="padding-top:0">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow"><Icon name="tool" /> Toolbox</p>
        <h2 class="section-title" id="skills-title">What I <mark>work with</mark></h2>
      </div>
      <div class="skills-bento reveal" data-css="display grid-template-columns gap">
        {skills.map((g) => (
          <section class="skill-card">
            <h3><span class="ico"><Icon name={skillIcons[g.group]} /></span> {g.group}</h3>
            <ul role="list">{g.items.map((it) => <li>{it}</li>)}</ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <!-- Education -->
  <section class="section" id="education" aria-labelledby="edu-title" style="padding-top:0">
    <div class="container split">
      <div class="panel reveal">
        <p class="eyebrow"><Icon name="graduation" /> Education</p>
        <h2 class="section-title" id="edu-title" style="margin-bottom:0.75rem;font-size:var(--step-3)">Studies</h2>
        {education.map((e) => (
          <div class="entry">
            <h3><Icon name="graduation" /> {e.degree}</h3><span class="when">{e.period}</span>
            <span class="school">{e.school}</span>
            <p>{e.note}</p>
          </div>
        ))}
      </div>
      <div class="panel reveal" style="--i:2">
        <p class="eyebrow"><Icon name="award" /> Credentials</p>
        <h2 class="section-title" style="margin-bottom:0.75rem;font-size:var(--step-3)">Certifications</h2>
        {certifications.map((c) => (
          <div class="entry">
            <h3><Icon name="award" /> {c.name}</h3><span class="when">{c.year}</span>
            <span class="school">{c.issuer}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="section alt" id="testimonials" aria-labelledby="quotes-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow"><Icon name="quote" /> Testimonials</p>
        <h2 class="section-title" id="quotes-title">What <mark>colleagues</mark> say</h2>
      </div>
      <div class="reveal" data-carousel aria-roledescription="carousel" aria-label="Testimonials">
        <div class="quotes" data-css="perspective scroll-snap-type overflow-x" data-track tabindex="0" aria-label="Testimonials, drag or scroll horizontally">
          {testimonials.map((t, i) => (
            <figure class="quote" data-css="animation-name animation-timeline transform" data-slide aria-roledescription="slide" aria-label={`${i + 1} of ${testimonials.length}`}>
              <blockquote>{t.quote}</blockquote>
              <figcaption><strong>{t.name}</strong><span>{t.role}, {t.org}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="carousel-controls">
          <button class="icon-btn" type="button" data-prev aria-label="Previous testimonial"><Icon name="arrow-left" /></button>
          <button class="icon-btn" type="button" data-next aria-label="Next testimonial"><Icon name="arrow-right" /></button>
          <span class="drag-hint" aria-hidden="true">Drag to browse</span>
          <span class="carousel-count" data-count-label aria-hidden="true">1 / {testimonials.length}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact: dark again, so the page ends where it started -->
  <section class="section dark" id="contact" aria-labelledby="contact-title">
    <div class="container contact-grid">
      <div class="reveal">
        <p class="eyebrow"><Icon name="send" /> Contact</p>
        <h2 class="contact-big" id="contact-title" data-css="font-stretch text-wrap">Let&rsquo;s build something <em>reliable</em>.</h2>
        <div class="contact-list">
          <a class="contact-row" href={`mailto:${profile.email}`} target="_blank" rel="noopener">
            <div class="lead"><Icon name="mail" /><div><small>Email</small><span>{profile.email}</span></div></div>
            <Icon name="arrow-up-right" />
          </a>
          <a class="contact-row" href={profile.whatsapp} rel="noopener" target="_blank">
            <div class="lead"><Icon name="whatsapp" /><div><small>WhatsApp</small><span>{profile.phone}</span></div></div>
            <Icon name="arrow-up-right" />
          </a>
          <a class="contact-row" href={profile.linkedin} rel="noopener" target="_blank">
            <div class="lead"><Icon name="linkedin" /><div><small>LinkedIn</small><span>linkedin.com/in/bagasaria</span></div></div>
            <Icon name="arrow-up-right" />
          </a>
          <a class="contact-row" href={profile.github} rel="noopener" target="_blank">
            <div class="lead"><Icon name="github" /><div><small>GitHub</small><span>github.com/bagasaria93</span></div></div>
            <Icon name="arrow-up-right" />
          </a>
        </div>
      </div>
      <form class="form reveal" style="--i:2" data-contact novalidate>
        <div class="form-row">
          <div class="field">
            <label for="f-name"><Icon name="user" /> Your name</label>
            <input id="f-name" name="name" type="text" autocomplete="name" required aria-describedby="e-name" />
            <span class="error" id="e-name"></span>
          </div>
          <div class="field">
            <label for="f-email"><Icon name="mail" /> Your email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required aria-describedby="e-email" />
            <span class="error" id="e-email"></span>
          </div>
        </div>
        <fieldset class="brief">
          <legend>What do you need?</legend>
          <div class="opts">
            {briefKinds.map((k) => (
              <label class="opt"><input type="checkbox" name="kind" value={k} /><span>{k}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset class="brief">
          <legend>When do you need it?</legend>
          <div class="opts">
            {briefWhen.map((w) => (
              <label class="opt"><input type="radio" name="when" value={w} /><span>{w}</span></label>
            ))}
          </div>
        </fieldset>
        <div class="field">
          <label for="f-msg"><Icon name="quote" /> Message</label>
          <textarea data-css="field-sizing resize" id="f-msg" name="message" required aria-describedby="e-msg"></textarea>
          <span class="error" id="e-msg"></span>
        </div>
        <button class="btn btn--primary" type="submit"><Icon name="send" /> Send message</button>
        <p class="form-note">Your choices are written into the email for you. It opens your email app in a new tab, and nothing is stored on this site.</p>
      </form>
    </div>
  </section>
</Base>
