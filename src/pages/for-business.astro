---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import projects from '../data/projects.json';
import { profile, testimonials } from '../data/site.js';

const kindIcons = { 'Cashier / POS': 'zap', 'Booking / reservation': 'calendar', 'HR and payroll': 'users', 'Manufacturing / ERP': 'building', 'Manufacturing / planning': 'chart', 'Customer management': 'user', 'WhatsApp and email blast': 'send' };
const byTitle = Object.fromEntries(projects.map((p) => [p.title, p]));
const systems = [
  { kind: 'Cashier / POS', title: 'KasirKu', best: 'Best for shops, cafes, restaurants', text: 'Ring up items, apply discounts, calculate tax and print a receipt, all from one simple screen.' },
  { kind: 'Booking / reservation', title: 'BookinAja', best: 'Best for salons, spas, clinics, workshops', text: 'Let customers pick their own appointment time and get instant confirmation, with no more juggling bookings over chat.' },
  { kind: 'HR and payroll', title: 'CG HRIS', best: 'Best for businesses with employees to manage', text: 'Attendance, leave requests, payroll and employee records in one place instead of scattered across spreadsheets.' },
  { kind: 'Manufacturing / ERP', title: 'ErpCore', best: 'Best for factories and production businesses', text: 'Track sales orders, production, warehouse stock and quality checks in one connected system.' },
  { kind: 'Manufacturing / planning', title: 'MRP Flow', best: 'Best for factories that need better material planning', text: 'Know what raw materials to buy and when, based on real orders and current stock, instead of guesswork.' },
  { kind: 'Customer management', title: 'MitraCRM', best: 'Best for sales-driven businesses', text: 'Track every lead and customer, see who is close to buying, and make sure no follow-up is forgotten.' },
  { kind: 'WhatsApp and email blast', title: 'BlazeNotif', best: 'Best for promotions, reminders, announcements', text: 'Send a message to many customers at once by WhatsApp or email, with a record of what was sent and to whom.' },
];
const industries = [
  'Gym and fitness', 'Restaurant and cafe', 'Electronics and gadgets', 'Beauty and skincare', 'Clinic and healthcare',
  'Contractor and construction', 'Automotive and workshop', 'Tutoring and courses', 'Manufacturing', 'Fintech and financing',
  'Garment and apparel', 'Building materials retail', 'Printing and publishing', 'Education and schools', 'Laundry and dry cleaning',
];
---
<Base
  title="Websites and custom systems for businesses | Bagas Aria Sativa"
  description="Company profile websites and custom business systems for small and medium businesses in Indonesia: cashier, booking, HR, ERP and CRM. Built around how your business actually works."
  path="/for-business/"
  current="business"
>
  <section class="page-head">
    <div class="container">
      <p class="eyebrow"><Icon name="building" /> For business owners</p>
      <h1 class="page-title" style="max-width:16ch">A website and system built around how your business actually works.</h1>
      <p class="page-lead">I am Bagas, a software developer based in Bekasi. I build company profile websites and custom business applications for small and medium businesses: cashier systems, booking systems, HR tools and more. No confusing tech talk, just something that works and helps you save time or bring in more customers.</p>
      <div class="hero-cta">
        <a class="btn btn--primary" href={profile.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" /> Chat on WhatsApp</a>
        <a class="btn btn--ghost" href="#systems"><Icon name="rocket" /> See live demos</a>
      </div>
    </div>
  </section>

  <section class="section" id="services" style="padding-top:2rem" aria-labelledby="services-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow"><Icon name="tool" /> Services</p>
        <h2 class="section-title" id="services-title">Two ways I can help</h2>
        <p class="section-lead">Whether you need an online presence or you are tired of running your business on WhatsApp groups and spreadsheets, here is what I offer.</p>
      </div>
      <div class="biz-grid">
        <article class="biz-card reveal">
          <h3><Icon name="globe" /> Company profile website</h3>
          <p>A professional website for your business. It shows who you are and what you offer, and makes it easy for people to reach you. Ideal if you do not have a website yet, or your current one looks outdated and is not bringing in new customers.</p>
          <ul role="list">
            <li>Home, about, and services or product pages built around your business, not a generic template</li>
            <li>Photo gallery, pricing section and a contact form or a direct WhatsApp button</li>
            <li>Looks good and works properly on phones, since that is how most customers will find you</li>
          </ul>
          <a class="link-arrow" href="/demo/company-profiles/"><span>See website demos by industry</span><Icon name="arrow-right" size={16} /></a>
        </article>
        <article class="biz-card reveal" style="--i:1">
          <h3><Icon name="server" /> Custom application or system</h3>
          <p>If managing your business by WhatsApp, Excel or paper is starting to slow you down, I can build a system made for how you operate. A few common examples:</p>
          <ul role="list">
            <li>Cashier and POS for shops, cafes and restaurants</li>
            <li>Booking and reservation, so customers can pick their own schedule</li>
            <li>HR and payroll for attendance, leave and salary calculation</li>
            <li>Manufacturing and production (ERP) to track orders, stock and production in one place</li>
            <li>Customer management (CRM) so no lead or follow-up gets forgotten</li>
            <li>WhatsApp and email blast to reach many customers at once</li>
            <li>Other systems, depending on what your business needs</li>
          </ul>
          <a class="link-arrow" href="#systems"><span>See system demos by type</span><Icon name="arrow-right" size={16} /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section" id="systems" style="padding-top:0" aria-labelledby="systems-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow"><Icon name="rocket" /> Live demos</p>
        <h2 class="section-title" id="systems-title">See it before you decide</h2>
        <p class="section-lead">Fully working demos that you can click through yourself, with no sign-up needed.</p>
      </div>
      <div class="systems">
        {systems.map((s, i) => {
          const p = byTitle[s.title];
          return (
            <a class="system reveal" style={`--i:${i % 3}`} href={p.href} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
              <small><Icon name={kindIcons[s.kind]} />{s.kind}</small>
              <h3>{s.title}</h3>
              <p class="best">{s.best}</p>
              <p>{s.text}</p>
            </a>
          );
        })}
      </div>
      <h3 class="section-title reveal" style="font-size:var(--step-3);margin-top:clamp(3rem,6vw,5rem)">Website demos, by industry</h3>
      <p class="section-lead reveal">Pick the field closest to your business and see what a real website for it could look like, before we build the actual one together.</p>
      <ul class="tags reveal" role="list" style="margin-top:1.5rem">
        {industries.map((n) => <li class="tag">{n}</li>)}
      </ul>
      <p class="reveal" style="margin-top:2rem"><a class="btn btn--ghost" href="/demo/company-profiles/"><Icon name="globe" /> Browse all 15 industry demos</a></p>
    </div>
  </section>

  <section class="section" id="proof" style="padding-top:0" aria-labelledby="proof-title">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow"><Icon name="quote" /> Proof of work</p>
        <h2 class="section-title" id="proof-title">In their words</h2>
        <p class="section-lead">Quotes from the people I have built systems for at Rainbrow Sulam Alis and PT Ganzu Gisma Seiko.</p>
      </div>
      <div class="biz-grid" style="grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr))">
        {testimonials.map((t, i) => (
          <figure class="quote reveal" style={`--i:${i}; flex: initial`}>
            <blockquote style="font-size:var(--step-1)">{t.quote}</blockquote>
            <figcaption><strong>{t.name}</strong><span>{t.role}, {t.org}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section band" id="contact" aria-labelledby="biz-contact-title">
    <div class="container contact-grid">
      <div class="reveal">
        <p class="eyebrow"><Icon name="send" /> Contact</p>
        <h2 class="contact-big" id="biz-contact-title">Let&rsquo;s talk about your <em>business</em>.</h2>
        <p class="section-lead">Open for new website and system projects. Not sure yet whether you need a website, a system, or both? Send a message describing your business and how you currently manage it. I will give you an honest answer on what would actually help, along with a price and timeline, before you decide anything.</p>
      </div>
      <div class="contact-list reveal" style="--i:2;margin-top:0">
        <a class="contact-row" href={profile.whatsapp} rel="noopener" target="_blank">
          <div class="lead"><Icon name="whatsapp" /><div><small>WhatsApp</small><span>{profile.phone}</span></div></div>
          <Icon name="arrow-up-right" />
        </a>
        <div class="contact-row">
          <div class="lead"><Icon name="mail" /><div><small>Email</small><span>{profile.email}</span></div></div>
          <button type="button" data-copy-email>Copy</button>
        </div>
        <a class="contact-row" href="/">
          <div class="lead"><Icon name="home" /><div><small>Portfolio</small><span>Back to the full portfolio</span></div></div>
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
  </section>
</Base>
