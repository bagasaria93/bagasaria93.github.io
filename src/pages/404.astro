---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Page not found | Bagas Aria Sativa" path="/404/" noindex>
  <section class="section">
    <div class="container notfound">
      <p class="eyebrow">Error 404</p>
      <p class="code" aria-hidden="true">404</p>
      <h1 class="section-title">This page does not exist.</h1>
      <p class="section-lead">The link may be old or mistyped. Here is where you can go instead.</p>
      <div class="hero-cta">
        <a class="btn btn--primary" href="/">Back to home <Icon name="arrow-right" /></a>
        <a class="btn btn--ghost" href="/work/">Browse all work</a>
      </div>
    </div>
  </section>
</Base>
